# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/prisma/test-dbs/

# local test/browser harness output
/.playwright-mcp/

# local SQLite runtime databases
/dev.db
/dev.db-journal
/prisma/dev.db
/prisma/dev.db-journal
/prisma/prisma/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# local runtime/session artifacts
cookies.txt
scratchpad.md

# root-level manual QA screenshots
/*.png

# local AI/tool runtime caches
/.opencode/tmp/
/.opencode/node_modules/

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma
