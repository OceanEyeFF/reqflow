// Prisma schema for ReqFlow - 轻量工单需求协作系统

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── 用户 ──────────────────────────────────────────────
model User {
  id           String   @id @default(cuid())
  username     String   @unique
  displayName  String
  email        String   @unique
  passwordHash String
  avatarUrl    String?
  role         String   @default("user") // admin | manager | user
  department   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // relations
  createdTickets   Ticket[]           @relation("TicketCreator")
  assignedTickets  Ticket[]           @relation("TicketAssignee")
  comments         TicketComment[]
  logs             TicketLog[]
  memberships      TicketMember[]
  notifications    Notification[]
  accounts         Account[]
  sessions         Session[]
  attachments      TicketAttachment[]
  aiProviderConfigs AiProviderConfig[]
  embeddingProviderConfigs EmbeddingProviderConfig[]
  knowledgeBases    KnowledgeBase[]
  knowledgeSources  KnowledgeSource[]
  knowledgeVersions KnowledgeSourceVersion[]
}

// ─── NextAuth ───────────────────────────────────────────
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── 工单 ────────────────────────────────────────────────
model Ticket {
  id          String    @id @default(cuid())
  title       String
  description String?
  type        String    @default("需求") // 需求 | Bug | 设计 | 文案 | 数据 | 运营 | 其他
  priority   String    @default("medium") // low | medium | high | urgent
  status     String    @default("pending") // pending | processing | waiting_feedback | completed | closed | rejected
  creatorId  String
  assigneeId String?
  dueDate    DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  closedAt   DateTime?

  // relations
  creator     User             @relation("TicketCreator", fields: [creatorId], references: [id])
  assignee    User?            @relation("TicketAssignee", fields: [assigneeId], references: [id])
  members        TicketMember[]
  comments       TicketComment[]
  logs           TicketLog[]
  attachments    TicketAttachment[]
  notifications  Notification[]
}

// ─── 工单协作者 ─────────────────────────────────────────
model TicketMember {
  id        String   @id @default(cuid())
  ticketId  String
  userId    String
  role      String   @default("collaborator") // owner | collaborator | watcher
  createdAt DateTime @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id])

  @@unique([ticketId, userId])
}

// ─── 工单评论 ───────────────────────────────────────────
model TicketComment {
  id        String   @id @default(cuid())
  ticketId  String
  userId    String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id])
}

// ─── 通知 ────────────────────────────────────────────────
model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String // ticket_assigned | mentioned | status_changed | new_comment | member_added
  title     String
  content   String?
  ticketId  String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user   User    @relation(fields: [userId], references: [id])
  ticket Ticket? @relation(fields: [ticketId], references: [id])
}

// ─── 工单附件 ────────────────────────────────────────────
model TicketAttachment {
  id        String   @id @default(cuid())
  ticketId  String
  userId    String
  filename  String
  fileUrl   String
  fileSize  Int
  mimeType  String
  createdAt DateTime @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id])
}

// ─── 工单日志 ───────────────────────────────────────────
model TicketLog {
  id        String   @id @default(cuid())
  ticketId  String
  userId    String
  action    String // created | status_changed | assignee_changed | member_added | member_removed | priority_changed | closed
  oldValue  String?
  newValue  String?
  createdAt DateTime @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id])
}

// ─── AI Provider 配置 ───────────────────────────────────
model AiProviderConfig {
  id          String   @id @default(cuid())
  name        String   @default("default")
  baseUrl     String
  model       String
  apiKey      String?
  noKeyMode   Boolean  @default(false)
  enabled     Boolean  @default(true)
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  updatedBy User? @relation(fields: [updatedById], references: [id])

  @@unique([name])
}

// ─── 知识库导入 ─────────────────────────────────────────
model KnowledgeBase {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  enabled     Boolean  @default(true)
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy User?             @relation(fields: [createdById], references: [id])
  sources   KnowledgeSource[]
}

model KnowledgeSource {
  id              String   @id @default(cuid())
  knowledgeBaseId String   @default("default")
  title           String
  status          String   @default("uploaded")
  enabled         Boolean  @default(false)
  createdById     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  knowledgeBase KnowledgeBase             @relation(fields: [knowledgeBaseId], references: [id], onDelete: Restrict)
  createdBy     User?                     @relation(fields: [createdById], references: [id])
  versions      KnowledgeSourceVersion[]
  snippets      KnowledgeSnippet[]

  @@index([knowledgeBaseId])
}

model KnowledgeSourceVersion {
  id               String   @id @default(cuid())
  sourceId         String
  version          Int      @default(1)
  originalFilename String
  storageKey       String
  mimeType         String
  fileSize         Int
  contentHash      String
  importType       String
  status           String   @default("uploaded")
  errorCode        String?
  createdById      String?
  createdAt        DateTime @default(now())

  source    KnowledgeSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  createdBy User?           @relation(fields: [createdById], references: [id])
  snippets  KnowledgeSnippet[]

  @@unique([sourceId, version])
}

model KnowledgeSnippet {
  id          String   @id @default(cuid())
  sourceId    String
  versionId   String
  sourcePath  String
  section     String?
  content     String
  chunkIndex  Int
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())

  source  KnowledgeSource        @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  version KnowledgeSourceVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  searchMetadata KnowledgeSnippetSearchMetadata?
  embeddings      KnowledgeEmbedding[]

  @@unique([versionId, sourcePath, chunkIndex])
}

model EmbeddingProviderConfig {
  id          String   @id @default(cuid())
  name        String   @default("default")
  provider    String
  baseUrl     String?
  model       String
  dimensions  Int
  apiKey      String?
  noKeyMode   Boolean  @default(false)
  enabled     Boolean  @default(true)
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  updatedBy User?                @relation(fields: [updatedById], references: [id])
  profiles  SearchIndexProfile[]

  @@unique([name])
}

model SearchIndexProfile {
  id                        String   @id @default(cuid())
  name                      String   @default("default")
  embeddingProviderConfigId String?
  embeddingProvider         String
  embeddingModel            String
  embeddingDimensions       Int
  semanticSpace             String
  lexicalEngine             String
  status                    String   @default("building")
  isActive                  Boolean  @default(false)
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  embeddingProviderConfig EmbeddingProviderConfig? @relation(fields: [embeddingProviderConfigId], references: [id], onDelete: SetNull)
  embeddings              KnowledgeEmbedding[]

  @@unique([name])
  @@index([status, isActive])
  @@index([embeddingProvider, embeddingModel, embeddingDimensions])
}

model KnowledgeSnippetSearchMetadata {
  id                 String   @id @default(cuid())
  snippetId          String   @unique
  sourcePath         String
  section            String?
  documentTitle      String?
  lexicalText        String
  contentHash        String
  domainEntities     String[]
  processNames       String[]
  materialTypes      String[]
  approvalActions    String[]
  applicabilityRules String[]
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  snippet KnowledgeSnippet @relation(fields: [snippetId], references: [id], onDelete: Cascade)

  @@index([sourcePath])
  @@index([contentHash])
}

model KnowledgeEmbedding {
  id           String   @id @default(cuid())
  snippetId    String
  profileId    String
  model        String
  dimensions   Int
  contentHash  String
  status       String   @default("pending")
  vectorRef    String?
  embedding    Unsupported("public.vector")?
  errorCode    String?
  generatedAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  snippet KnowledgeSnippet    @relation(fields: [snippetId], references: [id], onDelete: Cascade)
  profile SearchIndexProfile @relation(fields: [profileId], references: [id], onDelete: Restrict)

  @@unique([snippetId, profileId])
  @@index([profileId, status])
  @@index([contentHash])
}
